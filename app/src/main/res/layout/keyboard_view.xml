            <Button android:id="@+id/sym_ar_dot" android:text="." style="@style/KeyStyle123"/>
            <ImageButton android:id="@+id/btn_enter_ar_sym" android:src="@drawable/ic_enter" android:background="@drawable/bg_enter" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1.2" android:layout_margin="1dp" android:scaleType="centerInside"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================== واجهة الرموز الإضافية (عربي) - مطابقة للصورة ================== -->
