<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="2dp">

    <!-- ================== واجهة اللغة العربية (من اليمين للشمال) ================== -->
    <LinearLayout
        android:id="@+id/layout_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:visibility="visible">

        <!-- الصف الأول -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/ar_ج" android:text="ج" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ح" android:text="ح" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_خ" android:text="خ" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ه" android:text="ه" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ع" android:text="ع" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_غ" android:text="غ" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ف" android:text="ف" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ق" android:text="ق" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ث" android:text="ث" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ص" android:text="ص" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ض" android:text="ض" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف التاني -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/ar_ط" android:text="ط" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ك" android:text="ك" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_م" android:text="م" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ن" android:text="ن" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ت" android:text="ت" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ا" android:text="ا" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ل" android:text="ل" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ب" android:text="ب" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ي" android:text="ي" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_س" android:text="س" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ش" android:text="ش" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف التالت -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_del_ar" style="@style/KeyStyleAction" android:layout_weight="1.2" android:backgroundTint="#2C2C2C" android:foreground="@drawable/ic_backspace"/>
            <Button android:id="@+id/ar_د" android:text="د" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ظ" android:text="ظ" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ز" android:text="ز" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_و" android:text="و" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ة" android:text="ة" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ى" android:text="ى" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ر" android:text="ر" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ؤ" android:text="ؤ" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ء" android:text="ء" style="@style/KeyStyle"/>
            <Button android:id="@+id/ar_ذ" android:text="ذ" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف الرابع -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_enter_ar" style="@style/KeyStyleAction" android:layout_weight="1.2" android:backgroundTint="#4285F4" android:foreground="@drawable/ic_enter"/>
            <Button android:id="@+id/btn_space_ar" android:text="مسافة" style="@style/KeyStyleSpace" android:layout_weight="5"/>
            <Button android:id="@+id/btn_lang_to_en" style="@style/KeyStyleAction" android:layout_weight="1" android:backgroundTint="#2C2C2C" android:foreground="@drawable/ic_globe"/>
            <Button android:id="@+id/btn_123_ar" android:text="؟123" style="@style/KeyStyleAction" android:layout_weight="1.2"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================== واجهة اللغة الإنجليزية ================== -->
    <LinearLayout
        android:id="@+id/layout_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="ltr"
        android:visibility="gone">

        <!-- الصف الأول -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/en_q" android:text="q" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_w" android:text="w" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_e" android:text="e" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_r" android:text="r" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_t" android:text="t" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_y" android:text="y" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_u" android:text="u" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_i" android:text="i" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_o" android:text="o" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_p" android:text="p" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف التاني -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/en_a" android:text="a" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_s" android:text="s" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_d" android:text="d" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_f" android:text="f" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_g" android:text="g" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_h" android:text="h" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_j" android:text="j" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_k" android:text="k" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_l" android:text="l" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف التالت -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/en_shift" style="@style/KeyStyleAction" android:layout_weight="1.2" android:backgroundTint="#2C2C2C" android:foreground="@drawable/ic_shift"/>
            <Button android:id="@+id/en_z" android:text="z" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_x" android:text="x" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_c" android:text="c" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_v" android:text="v" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_b" android:text="b" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_n" android:text="n" style="@style/KeyStyle"/>
            <Button android:id="@+id/en_m" android:text="m" style="@style/KeyStyle"/>
            <Button android:id="@+id/btn_del_en" style="@style/KeyStyleAction" android:layout_weight="1.2" android:backgroundTint="#2C2C2C" android:foreground="@drawable/ic_backspace"/>
        </LinearLayout>

        <!-- الصف الرابع -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_123_en" android:text="!#1" style="@style/KeyStyleAction" android:layout_weight="1.2"/>
            <Button android:id="@+id/btn_space_en" android:text="Space" style="@style/KeyStyleSpace" android:layout_weight="5"/>
            <Button android:id="@+id/btn_lang_to_ar" style="@style/KeyStyleAction" android:layout_weight="1" android:backgroundTint="#2C2C2C" android:foreground="@drawable/ic_globe"/>
            <Button android:id="@+id/btn_enter_en" style="@style/KeyStyleAction" android:layout_weight="1.2" android:backgroundTint="#4285F4" android:foreground="@drawable/ic_enter"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
