            <Button android:id="@+id/sym_ar_underscore" android:text="_" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_amp" android:text="&amp;" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_minus" android:text="-" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_plus" android:text="+" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_paren1" android:text="(" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_paren2" android:text=")" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_slash" android:text="/" style="@style/KeyStyle"/>
        </LinearLayout>
        
