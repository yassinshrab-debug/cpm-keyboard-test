            <Button android:id="@+id/sym_ar_7" android:text="٧" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_8" android:text="٨" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_9" android:text="٩" style="@style/KeyStyle"/>
            <Button android:id="@+id/sym_ar_0" android:text="٠" style="@style/KeyStyle"/>
        </LinearLayout>
        
        <!-- الصف الثاني -->
